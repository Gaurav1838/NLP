      "source": [
        "import re\n",
        "\n",
        "# Read input\n",
        "text = input(\"Enter a paragraph:\\n\")\n",
        "word = input(\"Enter the word to search:\\n\")\n",
        "\n",
        "# Find all occurrences (case-insensitive)\n",
        "matches = re.findall(word, text, re.IGNORECASE)\n",
        "\n",
        "# Display result\n",
        "print(\"Number of occurrences:\", len(matches))\n"
      ],
